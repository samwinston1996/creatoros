{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreatorOS LicenseRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asset_id",
    "title",
    "creator",
    "source_url",
    "downloaded",
    "license",
    "evidence",
    "review_status"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "asset_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "creator": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri", "minLength": 1},
    "downloaded": {"type": "string", "format": "date"},
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "commercial_use", "attribution_required", "attribution_text"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri", "minLength": 1},
        "commercial_use": {"type": "boolean"},
        "attribution_required": {"type": "boolean"},
        "attribution_text": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "array",
      "items": {"type": "string", "format": "uri", "minLength": 1},
      "minItems": 1
    },
    "production_changes": {"type": "array"},
    "review_status": {"enum": ["needs-human-review", "approved", "rejected"]}
  }
}
